# Observability — all optional. Leave unset for a fully inert build/runtime.

# Sentry error + performance monitoring.
# When NEXT_PUBLIC_SENTRY_DSN is unset, Sentry is not wired into the build at
# all (no client SDK, no instrumentation hook) — zero overhead.
#   - NEXT_PUBLIC_SENTRY_DSN: client DSN (also used as the fallback server DSN)
#   - SENTRY_DSN: optional separate server/edge DSN
#   - SENTRY_AUTH_TOKEN / SENTRY_ORG / SENTRY_PROJECT: only needed to upload
#     source maps during `next build`; safe to omit (build won't fail).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# Web Vitals beacon endpoint (prod only). When unset, LCP/INP/CLS are logged to
# the console in dev and simply dropped in prod (no network calls).
NEXT_PUBLIC_WEB_VITALS_URL=
